# API endpoints
PUBLIC_REST_URL=http://localhost:1317
PUBLIC_RPC_URL=http://localhost:26657

# Web3Auth client ID for social login (Google)
# Get yours at https://dashboard.web3auth.io
PUBLIC_WEB3AUTH_CLIENT_ID=your_web3auth_client_id_here

# Web3Auth network configuration
# Valid values: sapphire_devnet, sapphire_mainnet, testnet (legacy), mainnet (legacy)
PUBLIC_WEB3AUTH_NETWORK=sapphire_devnet

# AI Assistant Configuration (authenticated Morpheus relay)
# The Node relay is the only process that contacts this endpoint or reads the
# provider key. The browser and nginx only call the relay on the same origin.
PUBLIC_MORPHEUS_URL=https://api.mor.org/api/v1

# Morpheus model to use for chat
PUBLIC_MORPHEUS_MODEL=minimax-m2.5

# Morpheus API key — server-side only, never sent to the browser or nginx
MORPHEUS_API_KEY=

# Wallet/chain binding for relay sessions. Production must use its public HTTPS
# origin and leave cookie security enabled. Local HTTP development must disable
# Secure cookies as shown here.
PUBLIC_CHAIN_ID=manifest-ledger-beta
MORPHEUS_RELAY_ALLOWED_ORIGINS=http://localhost:3000
MORPHEUS_RELAY_AUDIENCE=http://localhost:3000/api/morpheus
MORPHEUS_RELAY_COOKIE_SECURE=false
MORPHEUS_RELAY_STATE_FILE=/tmp/barney-morpheus-relay-ledger.json

# Required fail-closed daily policy. Money is integer micro-USD. These local
# example rates match the listed MiniMax M2.5 input/output prices at the time of
# writing; production operators must re-check current rates for the selected model.
# https://apidocs.mor.org/documentation/models/pricing
MORPHEUS_RELAY_IDENTITY_DAILY_REQUESTS=100
MORPHEUS_RELAY_IDENTITY_DAILY_TOKENS=1000000
MORPHEUS_RELAY_IDENTITY_DAILY_SPEND_MICRO_USD=2000000
MORPHEUS_RELAY_PROVIDER_DAILY_BUDGET_MICRO_USD=25000000
MORPHEUS_RELAY_INPUT_MICRO_USD_PER_MILLION_TOKENS=300000
MORPHEUS_RELAY_OUTPUT_MICRO_USD_PER_MILLION_TOKENS=1200000

# Optional policy overrides (defaults shown)
# MORPHEUS_RELAY_ALLOWED_MODELS=minimax-m2.5
# MORPHEUS_RELAY_MAX_BODY_BYTES=524288
# MORPHEUS_RELAY_MAX_PROMPT_CHARS=120000
# MORPHEUS_RELAY_MAX_CONTEXT_BYTES=393216
# MORPHEUS_RELAY_ESTIMATED_BYTES_PER_TOKEN=3
# MORPHEUS_RELAY_MAX_OUTPUT_TOKENS=4096
# MORPHEUS_RELAY_MAX_IDENTITY_CONCURRENT=2
# MORPHEUS_RELAY_MAX_PROVIDER_CONCURRENT=16
# MORPHEUS_RELAY_MAX_DAILY_IDENTITIES=1000
# MORPHEUS_RELAY_MAX_STREAM_SECONDS=120
# MORPHEUS_RELAY_UPSTREAM_CONNECT_TIMEOUT_SECONDS=15
# MORPHEUS_RELAY_READINESS_CACHE_SECONDS=30
# MORPHEUS_RELAY_HOST=127.0.0.1
# MORPHEUS_RELAY_IDENTITY_HMAC_KEY=separate-persistent-secret

# PWR token factory denom (optional, defaults to local factory address)
# PUBLIC_PWR_DENOM=factory/manifest1.../upwr

# Chain configuration (gas price is optional; chain ID above is required by the relay)
# PUBLIC_GAS_PRICE=0.0025factory/manifest1afk9zr2hn2jsac63h4hm60vl9z3e5u69gndzf7c99cqge3vzwjzsfmy9qj/upwr

# Faucet endpoint URL (optional, enables auto-refill when set)
# PUBLIC_FAUCET_URL=http://localhost:8000

# AI tuning (optional — values must be positive integers; zero is treated as unset)
# PUBLIC_AI_STREAM_TIMEOUT_MS=30000          # Chat response-header timeout after auth (ms, max 120000)
# PUBLIC_AI_DEPLOY_PROVISION_TIMEOUT_MS=600000 # Deploy provisioning timeout (ms, max 900000 — default is fred's ProvisionTimeout)
# PUBLIC_AI_TOOL_API_TIMEOUT_MS=15000        # Blockchain API call timeout (ms, max 60000)
# PUBLIC_AI_MAX_RETRIES=3                    # Stream retry attempts (count, max 10)
# PUBLIC_AI_CONFIRMATION_TIMEOUT_MS=300000   # TX confirmation auto-cancel (ms, max 600000)
# PUBLIC_AI_MAX_TOOL_ITERATIONS=10           # Tool calls per message (count, max 50)
# PUBLIC_AI_MAX_MESSAGES=200                 # Chat history depth (count, max 1000)
# PUBLIC_AI_BATCH_DEPLOY_CONCURRENCY=4       # Concurrent batch deploys (count, max 10)

# Resource specs per SKU name (JSON). Chain provides names + prices; this provides specs.
# Different networks ship different SKUs — env var keeps that out of the codebase.
# Empty string disables deploy until specs are configured.
# Insertion order controls presentation: the deploy_app size enum and the /help table render in this order.
# The deploy_app default size is the cheapest tier by pricePerHour, not the first entry.
# Value is unquoted bare JSON — works in both dotenv (rsbuild) and Docker env-file paths.
# docker/config.js.template wraps the substitution in single quotes for safe JS embedding.
PUBLIC_SKU_SPECS={"docker-micro":{"cores":0.5,"ramMB":512,"diskGB":1},"docker-small":{"cores":1,"ramMB":1024,"diskGB":5},"docker-medium":{"cores":2,"ramMB":2048,"diskGB":10},"docker-large":{"cores":4,"ramMB":4096,"diskGB":20}}
