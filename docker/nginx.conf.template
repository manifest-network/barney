# --- Morpheus proxy abuse controls (ENG-571) -------------------------------
# The /api/morpheus/ location injects the operator's paid API key server-side,
# and this is a static SPA with no login, so the endpoint is reachable by
# anyone who can load the frontend. These http-context directives (this file is
# included inside `http {}`) cap abuse. envsubst in env.sh is given an explicit
# variable list, so the nginx runtime vars below ($binary_remote_addr, etc.)
# are left untouched.
#
# Rate + concurrency cap per client IP — the real mitigation for billing-DoS.
limit_req_zone  $binary_remote_addr zone=morpheus_req:10m  rate=10r/s;
limit_conn_zone $binary_remote_addr zone=morpheus_conn:10m;
#
# Origin allow-check: resolve the request's effective origin host. No Origin
# header (native clients / same-origin GET) maps to $http_host so it passes;
# a present same-origin Origin maps to its own host (== $http_host) and passes;
# a cross-site or malformed Origin yields a value that won't match $http_host
# and is rejected in the location below. This is a speed bump against browser
# cross-site relay, not authentication (a plain curl sends no Origin and is
# only rate-limited). NOTE: if a front proxy/LB rewrites the Host header, set
# this comparison against the externally-visible host instead.
map $http_origin $morpheus_origin_host {
    default                    "cross-site";
    ""                         $http_host;
    "~^https?://(?<oh>[^/]+)$" $oh;
}
# ---------------------------------------------------------------------------

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # HTTP/2 cleartext (h2c) — enables multiplexing when a TLS-terminating
    # load balancer or reverse proxy connects to this backend via h2c
    http2 on;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Gzip compression
    gzip on;
    gzip_comp_level 6;
    gzip_vary on;
    gzip_buffers 16 8k;
    gzip_min_length 256;
    gzip_types text/css application/javascript application/json image/svg+xml application/wasm text/plain text/xml application/xml;

    # Brotli compression (~15-20% smaller than gzip at comparable CPU cost)
    brotli on;
    brotli_comp_level 6;
    brotli_min_length 256;
    brotli_types text/css application/javascript application/json image/svg+xml application/wasm text/plain text/xml application/xml;

    # index.html and config.js must always be fresh
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location = /config.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Rsbuild hashed static assets — cache aggressively
    location /static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Morpheus API reverse proxy — injects auth header server-side.
    #
    # Uses a regex location so we can capture the path tail and put the full
    # upstream URL in a `proxy_pass` variable. The variable form enables
    # runtime DNS re-resolution via nginx's resolver; with `valid=30s`, nginx
    # caches the answer for up to 30s before refreshing it. With a literal
    # hostname, nginx caches the upstream IP forever at config-load time,
    # which broke prod whenever api.mor.org rotated its IP. The capture
    # group + $is_args$args lets us forward both the path and query string
    # without splitting PUBLIC_MORPHEUS_URL apart in env.sh.
    #
    # NAMED capture ($mpath), not positional $1: the $morpheus_origin_host map
    # below runs a regex on $http_origin whose capture would overwrite the
    # shared positional $1 from this location, corrupting the upstream path for
    # every request that carries an Origin header — i.e. every browser request
    # (ENG-587). Named captures occupy their own slot and survive.
    location ~ ^/api/morpheus/(?<mpath>.*)$ {
        # Fast-fail when no API key is configured (envsubst replaces this at startup)
        set $morpheus_key "${MORPHEUS_API_KEY}";
        if ($morpheus_key = '') {
            return 503;
        }

        # Abuse controls (ENG-571). `if` with `return` is a safe use of if.
        # Reject browser requests carrying a cross-site/malformed Origin.
        if ($morpheus_origin_host != $http_host) {
            return 403;
        }
        # Per-IP rate + concurrency limits; 429 on trip.
        limit_req    zone=morpheus_req burst=20 nodelay;
        limit_conn   morpheus_conn 8;
        limit_req_status  429;
        limit_conn_status 429;

        resolver ${NGINX_RESOLVERS} valid=30s ipv6=off;
        resolver_timeout 5s;

        set $morpheus_upstream "${PUBLIC_MORPHEUS_URL}/$mpath$is_args$args";
        proxy_pass $morpheus_upstream;
        proxy_ssl_server_name on;
        proxy_set_header Authorization "Bearer ${MORPHEUS_API_KEY}";
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE streaming support
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
    }

    # SPA fallback — serve index.html for client-side routes
    location / {
        try_files $uri $uri/ /index.html;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
}
