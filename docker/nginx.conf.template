# --- Morpheus relay defense in depth (ENG-571 + ENG-831) -------------------
# The paid key is owned exclusively by the localhost Node relay. Nginx keeps
# origin, IP-rate, connection, and body-size controls in front of that relay,
# but wallet authentication and financial accounting are enforced downstream.
# This file is included inside `http {}`. envsubst receives an explicit list so
# nginx runtime variables ($binary_remote_addr, etc.) remain untouched.
#
# Restore the external client address only when the immediate peer belongs to
# the explicitly configured Traefik/Docker proxy CIDR. Identity quotas never
# trust this address; it is only a coarse abuse-control key.
set_real_ip_from ${BARNEY_TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Coarse rate + concurrency cap per validated client IP.
limit_req_zone  $binary_remote_addr zone=morpheus_req:10m  rate=10r/s;
limit_conn_zone $binary_remote_addr zone=morpheus_conn:10m;
#
# Origin allow-check: resolve the request's effective origin host. No Origin
# header (native clients / same-origin GET) maps to $http_host so it passes;
# a present same-origin Origin maps to its own host (== $http_host) and passes;
# a cross-site or malformed Origin yields a value that won't match $http_host
# and is rejected in the location below. This is a speed bump against browser
# cross-site relay, not authentication (a plain curl sends no Origin and is
# only rate-limited). NOTE: if a front proxy/LB rewrites the Host header, set
# this comparison against the externally-visible host instead.
map $http_origin $morpheus_origin_host {
    default                    "cross-site";
    ""                         $http_host;
    "~^https?://(?<oh>[^/]+)$" $oh;
}
# ---------------------------------------------------------------------------

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # HTTP/2 cleartext (h2c) — enables multiplexing when a TLS-terminating
    # load balancer or reverse proxy connects to this backend via h2c
    http2 on;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Gzip compression
    gzip on;
    gzip_comp_level 6;
    gzip_vary on;
    gzip_buffers 16 8k;
    gzip_min_length 256;
    gzip_types text/css application/javascript application/json image/svg+xml application/wasm text/plain text/xml application/xml;

    # Brotli compression (~15-20% smaller than gzip at comparable CPU cost)
    brotli on;
    brotli_comp_level 6;
    brotli_min_length 256;
    brotli_types text/css application/javascript application/json image/svg+xml application/wasm text/plain text/xml application/xml;

    # index.html and config.js must always be fresh
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location = /config.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Rsbuild hashed static assets — cache aggressively
    location /static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Keep the namespace root out of the SPA fallback; it is not an API route.
    location = /api/morpheus {
        return 404;
    }

    # Authenticated/accounted Morpheus relay. The original path is preserved;
    # the relay has an exact route/method allowlist and is the only process that
    # can read the provider credential. `if` with `return` is a safe nginx use of if.
    location ^~ /api/morpheus/ {
        # Reject browser requests carrying a cross-site/malformed Origin.
        if ($morpheus_origin_host != $http_host) {
            return 403;
        }
        # Per-IP rate + concurrency limits; 429 on trip.
        limit_req    zone=morpheus_req burst=20 nodelay;
        # Keep this above the relay's provider-wide concurrency ceiling so a
        # misconfigured real-IP trust boundary cannot become an 8-user global
        # bottleneck. Wallet/provider gates remain authoritative downstream.
        limit_conn   morpheus_conn 32;
        limit_req_status  429;
        limit_conn_status 429;
        client_max_body_size 4m;

        proxy_pass http://127.0.0.1:${MORPHEUS_RELAY_PORT};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

        # SSE streaming support
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 910s;
        proxy_send_timeout 30s;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
    }

    # SPA fallback — serve index.html for client-side routes
    location / {
        try_files $uri $uri/ /index.html;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
}
