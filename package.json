{
  "name": "barney",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server/dev.mjs",
    "build": "tsc -b && rsbuild build",
    "build-release": "node scripts/update-version.cjs && tsc -b && rsbuild build && node scripts/check-bundle.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "update-version": "node scripts/update-version.cjs",
    "lint": "eslint .",
    "preview": "rsbuild preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "patch-package --error-on-fail"
  },
  "overrides": {
    "axios": "$axios",
    "image-size": "1.2.1",
    "postcss": "$postcss",
    "protobufjs": "7.6.6",
    "uuid": "11.1.1",
    "ws@^7": "7.5.13",
    "ws@^8": "8.21.3"
  },
  "dependencies": {
    "@chain-registry/types": "0.50.297",
    "@cosmjs/proto-signing": "0.32.4",
    "@cosmjs/stargate": "npm:@manifest-network/stargate@0.32.4-ll.3",
    "@cosmos-kit/react": "2.22.3",
    "@cosmos-kit/web3auth": "npm:@manifest-network/web3auth@2.16.6-ll.1",
    "@interchain-ui/react": "1.26.3",
    "@manifest-network/manifest-sdk": "0.22.0",
    "@manifest-network/manifestjs": "3.0.0",
    "axios": "1.20.0",
    "clsx": "2.1.1",
    "focus-trap-react": "12.0.0",
    "ipaddr.js": "2.3.0",
    "lucide-react": "0.563.0",
    "next-themes": "0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tldts": "7.0.30",
    "zod": "4.3.6",
    "zustand": "5.0.11"
  },
  "optionalDependencies": {
    "@react-native-async-storage/async-storage": "1.24.0",
    "ox": "0.11.3",
    "utf-8-validate": "5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@rsbuild/core": "1.7.6",
    "@rsbuild/plugin-node-polyfill": "1.4.6",
    "@rsbuild/plugin-react": "1.4.6",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.19.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "17.0.0",
    "happy-dom": "20.14.3",
    "patch-package": "8.0.1",
    "postcss": "8.5.28",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
